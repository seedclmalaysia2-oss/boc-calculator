{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mockup",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "mockup", "-l", "4321", "--no-clipboard"],
      "port": 4321
    },
    {
      "name": "legacy",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "legacy", "-l", "4322", "--no-clipboard"],
      "port": 4322
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
